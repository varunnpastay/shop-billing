# OPTIONAL settings. Copy this file to db.properties (in the app folder) and remove the # in front of a line to use it.

# Port, if another program already uses 8080 (then open http://localhost:8081):
# PORT=8081

# When the daily backup to GitHub runs (default: 1 PM and 8 PM every day). Format: second minute hour day month weekday
# EXPORT_CRON=0 0 13,20 * * *
