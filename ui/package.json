{
  "name": "shop-billing-ui",
  "private": true,
  "description": "Builds src/main/resources/static/css/app.css with Tailwind CSS. Only needed when changing the look; the built file is committed.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i app.css -o ../src/main/resources/static/css/app.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i app.css -o ../src/main/resources/static/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource/gelasio": "^5.3.0",
    "gsap": "^3.12.5",
    "tailwindcss": "3.4.17"
  }
}
